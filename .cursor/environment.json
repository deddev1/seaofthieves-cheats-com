{
  "name": "Sea of Thieves Cheats",
  "install": "npm ci && npm run build",
  "start": "npm run localhost",
  "ports": [
    {
      "name": "Sea of Thieves Cheats site",
      "port": 5173
    },
    {
      "name": "Sea of Thieves Cheats dev (hot reload)",
      "port": 4321
    }
  ],
  "terminals": [
    {
      "name": "localhost",
      "command": "npm run localhost",
      "description": "Production preview at http://localhost:5173"
    },
    {
      "name": "localhost-dev",
      "command": "npm run localhost:dev",
      "description": "Dev server with hot reload at http://localhost:4321"
    }
  ]
}
