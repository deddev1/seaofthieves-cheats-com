---
import TrustBar from './TrustBar.astro';
import type { LocaleCode } from '../data/i18n/locales';
import { defaultLocale } from '../data/i18n/locales';
import { productInfo, siteConfig } from '../data/site';
import { heroWidth, heroHeight, heroSrcSet, heroSizes, heroSrc } from '../lib/responsive-images';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = getT(locale);
const monthly = productInfo.plans.find((p) => p.id === 'monthly') ?? productInfo.plans[0];
const title = t('hero.title');
const subtitle = t('hero.subtitle');
const ctaBuy = t('cta.buy');
const priceFrom = t('hero.priceFrom');
const priceLabel = priceFrom ? `${priceFrom} $${monthly.price}` : `$${monthly.price}`;
const imageAlt = t('hero.imageAlt', { brand: siteConfig.name });

const chipKeys = [
	{ key: 'chipEsp', icon: 'esp', edit: 'chipEsp' },
	{ key: 'chipAim', icon: 'aim', edit: 'chipAim' },
	{ key: 'chipRadar', icon: 'radar', edit: 'chipRadar' },
	{ key: 'chipUpdates', icon: 'updates', edit: 'chipUpdates' },
] as const;
---

<div class="hero-stage">
	<section class="hero" aria-label={title}>
		<div class="hero__media">
			<img
				src={heroSrc}
				srcset={heroSrcSet}
				sizes={heroSizes}
				alt={imageAlt}
				width={heroWidth}
				height={heroHeight}
				fetchpriority="high"
				loading="eager"
				decoding="async"
			/>
		</div>
		<div class="hero__veil" aria-hidden="true"></div>
		<div class="shell hero__content">
			<div class="hero__copy">
				<h1 class="hero__brand">{title}</h1>
				<p class="hero__lede" data-edit="heroLede">{subtitle}</p>
				<div class="hero__actions">
					<a class="hero__buy" href={siteConfig.checkoutUrl} rel="noopener noreferrer">
						<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path
								d="M4.5 6.5h2.1l1.2 9.2h9.4l1.8-6.6H8.1M9.2 19.2a.9.9 0 100-1.8.9.9 0 000 1.8zm7.4 0a.9.9 0 100-1.8.9.9 0 000 1.8z"
								stroke="currentColor"
								stroke-width="1.7"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
						<span class="hero__buy-label" data-edit="ctaBuy">{ctaBuy}</span>
						<span class="hero__buy-price">{priceLabel}</span>
					</a>
				</div>
				<ul class="hero__features">
					{
						chipKeys.map((chip) => (
							<li>
								<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
									{chip.icon === 'esp' && (
										<>
											<circle cx="12" cy="12" r="7.5" stroke="currentColor" stroke-width="1.6" />
											<path
												d="M12 8.5v3.2L14.2 14"
												stroke="currentColor"
												stroke-width="1.6"
												stroke-linecap="round"
											/>
										</>
									)}
									{chip.icon === 'aim' && (
										<path
											d="M12 4.5l1.7 4.8H19l-4 3.1 1.5 4.8L12 14.8 7.5 17.2 9 12.4 5 9.3h5.3L12 4.5z"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linejoin="round"
										/>
									)}
									{chip.icon === 'radar' && (
										<>
											<circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6" />
											<circle cx="12" cy="12" r="7.5" stroke="currentColor" stroke-width="1.6" />
											<path
												d="M12 2.8v2.2M12 19v2.2M2.8 12h2.2M19 12h2.2"
												stroke="currentColor"
												stroke-width="1.6"
												stroke-linecap="round"
											/>
										</>
									)}
									{chip.icon === 'updates' && (
										<path
											d="M5 13.2l4.2 4.2L19 7.6"
											stroke="currentColor"
											stroke-width="1.8"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
									)}
								</svg>
								<span data-edit={chip.edit}>{t(`hero.${chip.key}`)}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>
	<TrustBar locale={locale} overlay />
</div>

<style is:global>
	.hero-stage {
		position: relative;
	}

	.hero {
		--hero-pad-y: clamp(1rem, 2vw, 1.75rem);
		--hero-stack: clamp(0.5rem, 1.1vw, 0.75rem);
		/* Tall fold hero — matches narakacheats.org (~75–80vh below nav). */
		--hero-min-h: clamp(34rem, 78vh, 52rem);
		position: relative;
		isolation: isolate;
		display: grid;
		align-items: center;
		overflow: hidden;
		background: var(--bg);
		width: 100%;
		min-height: var(--hero-min-h);
		height: var(--hero-min-h);
		max-height: none;
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 42%;
	}

	.hero__veil {
		position: absolute;
		inset: 0;
		z-index: 1;
		background:
			linear-gradient(180deg, color-mix(in srgb, var(--bg) 35%, transparent) 0%, transparent 35%),
			linear-gradient(90deg, color-mix(in srgb, var(--bg) 88%, transparent) 0%, transparent 55%),
			linear-gradient(0deg, color-mix(in srgb, var(--bg) 70%, transparent) 0%, transparent 40%);
		pointer-events: none;
	}

	.hero__content {
		position: relative;
		z-index: 2;
		padding-block: var(--hero-pad-y);
	}

	.hero__copy {
		display: grid;
		gap: var(--hero-stack);
		max-width: 36rem;
	}

	.hero__brand {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3.25rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.05;
		color: var(--ink-heading);
		text-wrap: balance;
	}

	.hero__lede {
		margin: 0;
		font-size: clamp(0.95rem, 1.6vw, 1.1rem);
		line-height: 1.55;
		color: var(--ink-muted);
		max-width: 32rem;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-top: 0.35rem;
	}

	.hero__buy {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		min-height: 2.85rem;
		padding: 0 1.25rem;
		border-radius: 999px;
		background: #fff;
		color: #09090b;
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
		transition:
			transform 0.2s ease,
			background 0.2s ease;
	}

	.hero__buy svg {
		width: 1.1rem;
		height: 1.1rem;
		flex-shrink: 0;
	}

	.hero__buy:hover {
		background: #ececef;
		color: #09090b;
		transform: translateY(-1px);
	}

	.hero__buy-price {
		padding-left: 0.45rem;
		margin-left: 0.1rem;
		border-left: 1px solid color-mix(in srgb, #09090b 15%, transparent);
		font-weight: 600;
		opacity: 0.85;
	}

	.hero__features {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 0.85rem;
		margin: 0.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	.hero__features li {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--ink-muted);
	}

	.hero__features svg {
		width: 0.95rem;
		height: 0.95rem;
		color: var(--magenta-soft);
		flex-shrink: 0;
	}

	@media (max-width: 680px) {
		.hero {
			--hero-min-h: clamp(28rem, 72vh, 40rem);
		}

		.hero__buy {
			width: 100%;
			justify-content: center;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__buy:hover {
			transform: none;
		}
	}
</style>
