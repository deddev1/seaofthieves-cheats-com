---
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { getBlogBasePath } from '../data/blog/helpers';
import { siteConfig } from '../data/site';
import { getT } from '../i18n/server';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const t = getT(locale);
const year = new Date().getFullYear();
const shareUrl = `${siteConfig.url}/`;
const encodedUrl = encodeURIComponent(shareUrl);
const encodedName = encodeURIComponent(siteConfig.name);
const tagline = t('footer.tagline').split('\n')[0];

const explore = [
	{ labelKey: 'nav.hacks', href: getLocalizedPath('home', locale) },
	{ labelKey: 'nav.esp', href: getLocalizedPath('sea-of-thieves-esp', locale) },
	{ labelKey: 'nav.aimbot', href: getLocalizedPath('sea-of-thieves-aimbot', locale) },
	{ labelKey: 'common.featureList', href: getLocalizedPath('features', locale) },
	{ labelKey: 'common.pricingPlans', href: getLocalizedPath('pricing', locale) },
	{ labelKey: 'nav.faq', href: getLocalizedPath('faq', locale) },
	{ labelKey: 'common.blog', href: getBlogBasePath(locale) },
	{ labelKey: 'common.guides', href: '/guides/' },
];

const help = [
	{ labelKey: 'nav.setup', href: getLocalizedPath('setup', locale) },
	{ labelKey: 'nav.updates', href: getLocalizedPath('updates', locale) },
	{ labelKey: 'common.buyerReviewsNav', href: '/reviews/' },
	{ labelKey: 'common.support', href: getLocalizedPath('support', locale) },
	{ labelKey: 'common.refundPolicy', href: getLocalizedPath('refund', locale) },
	{ labelKey: 'common.privacy', href: getLocalizedPath('privacy', locale) },
	{ labelKey: 'common.terms', href: getLocalizedPath('terms', locale) },
];

const shareLinks = [
	{
		label: t('common.shareX'),
		href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedName}`,
	},
	{
		label: t('common.shareReddit'),
		href: `https://reddit.com/submit?url=${encodedUrl}&title=${encodedName}`,
	},
	{
		label: t('common.shareFacebook'),
		href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
	},
];
---

<footer class="site-footer">
	<div class="shell site-footer__grid">
		<div>
			<p class="site-footer__brand">{siteConfig.name}</p>
			<p>{tagline}</p>
			<p class="site-footer__share-label">{t('common.share')}</p>
			<ul class="site-footer__share">
				{
					shareLinks.map((link) => (
						<li>
							<a href={link.href} rel="noopener noreferrer" target="_blank">
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
		<div>
			<p class="site-footer__label">{t('footer.explore')}</p>
			<ul>
				{
					explore.map((link) => (
						<li>
							<a href={link.href}>{t(link.labelKey)}</a>
						</li>
					))
				}
			</ul>
		</div>
		<div>
			<p class="site-footer__label">{t('footer.help')}</p>
			<ul>
				{
					help.map((link) => (
						<li>
							<a href={link.href}>{t(link.labelKey)}</a>
						</li>
					))
				}
				<li>
					<a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a>
				</li>
			</ul>
		</div>
	</div>
	<div class="shell site-footer__bottom">
		<p>{t('common.copyright', { year, brand: siteConfig.name })}</p>
	</div>
</footer>

<style is:global>
	.site-footer {
		background: var(--bg-panel);
		border-top: 1px solid var(--line-soft);
		padding-top: 3rem;
		padding-bottom: 2rem;
	}

	.site-footer__grid {
		display: grid;
		grid-template-columns: 1.4fr repeat(2, minmax(0, 1fr));
		gap: 2rem 2.5rem;
	}

	.site-footer__brand {
		margin: 0 0 0.5rem;
		font-family: var(--font-display);
		font-size: 1.1rem;
		font-weight: 800;
		color: var(--ink);
	}

	.site-footer__grid > div > p:not(.site-footer__brand):not(.site-footer__label):not(.site-footer__share-label) {
		margin: 0;
		color: var(--ink-muted);
		font-size: 0.9rem;
		line-height: 1.55;
		max-width: 22rem;
	}

	.site-footer__share-label {
		margin: 1.25rem 0 0.45rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.site-footer__share {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem 0.85rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-footer__share a {
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--ink-muted);
	}

	.site-footer__share a:hover {
		color: var(--accent-hover);
	}

	.site-footer__label {
		margin: 0 0 0.75rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-faint);
	}

	.site-footer__grid ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.45rem;
	}

	.site-footer__grid ul a {
		font-size: 0.88rem;
		color: var(--ink-muted);
	}

	.site-footer__grid ul a:hover {
		color: var(--accent-hover);
	}

	.site-footer__bottom {
		margin-top: 2.25rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--line-soft);
	}

	.site-footer__bottom p {
		margin: 0;
		font-size: 0.78rem;
		color: var(--ink-faint);
	}

	@media (max-width: 900px) {
		.site-footer__grid {
			grid-template-columns: 1fr 1fr;
		}

		.site-footer__grid > div:first-child {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 560px) {
		.site-footer__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
